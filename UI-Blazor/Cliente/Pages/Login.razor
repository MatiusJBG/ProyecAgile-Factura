@page "/login"
@layout EmptyLayout

@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Iniciar Sesión</PageTitle>

<div class="login-container">
    <div class="login-box">
        <h2 class="login-title">Iniciar Sesión</h2>
        
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(lockoutMessage))
        {
            <div class="alert alert-warning">
                @lockoutMessage
            </div>
        }

        <div class="form-group">
            <label for="username">Usuario</label>
            <input id="username" class="form-control" @bind="username" placeholder="Ingrese su usuario" />
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <input id="password" type="password" class="form-control" @bind="password" placeholder="Ingrese su contraseña" />
        </div>

        <button class="btn-login" @onclick="HandleLogin" disabled="@(isLoading || (lockoutEndTime.HasValue && lockoutEndTime.Value > DateTime.Now))">
            @if (isLoading)
            {
                <span>Cargando...</span>
            }
            else
            {
                <span>Ingresar</span>
            }
        </button>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading = false;
    private DateTime? lockoutEndTime;
    private string? lockoutMessage;
    private System.Threading.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await CheckLockoutState();
    }

    private async Task CheckLockoutState()
    {
        lockoutEndTime = await AuthService.GetLockoutEndTimeAsync();
        if (lockoutEndTime.HasValue && lockoutEndTime.Value > DateTime.Now)
        {
            StartCountdown();
        }
        else
        {
            lockoutMessage = null;
            timer?.Dispose();
            timer = null;
        }
    }

    private void StartCountdown()
    {
        timer?.Dispose();
        timer = new System.Threading.Timer(async _ =>
        {
            if (lockoutEndTime.HasValue && lockoutEndTime.Value > DateTime.Now)
            {
                var remaining = lockoutEndTime.Value - DateTime.Now;
                lockoutMessage = $"Demasiados intentos fallidos. Intente nuevamente en {remaining.Seconds} segundos.";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                lockoutMessage = null;
                lockoutEndTime = null;
                timer?.Dispose();
                timer = null;
                await InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            // Double check before calling service
            if (lockoutEndTime.HasValue && lockoutEndTime.Value > DateTime.Now)
            {
                return;
            }

            var result = await AuthService.LoginAsync(username, password);
            if (result)
            {
                NavigationManager.NavigateTo("/");
            }
            else
            {
                // Check if we are now locked out
                await CheckLockoutState();
                
                if (lockoutEndTime.HasValue && lockoutEndTime.Value > DateTime.Now)
                {
                    // Lockout message is handled by timer/CheckLockoutState
                }
                else
                {
                    errorMessage = "Usuario o contraseña incorrectos";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al intentar iniciar sesión";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }
    
    public void Dispose()
    {
        timer?.Dispose();
    }
}