@page "/productos"
@page "/productos/lista"
@attribute [Authorize]
@using UI_Blazor.Client.Models
@using UI_Blazor.Client.Services
@using Cliente.Components
@inject IProductoService ProductoService
@inject NavigationManager NavigationManager

<PageTitle>Productos | Dashboard</PageTitle>

<div class="productos-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-title-section">
            <h2 class="page-title">Gestión de Productos</h2>
            <p class="page-subtitle">Administra tu catálogo de productos y servicios</p>
        </div>
    </div>

    <!-- Tab navigation -->
    <div class="tabs-navigation">
        <button class="tab-btn @(currentView == "lista" ? "active" : "")" @onclick='() => ChangeView("lista")'>Lista General</button>
        <button class="tab-btn @(currentView == "nuevo" ? "active" : "")" @onclick='() => ChangeView("nuevo")'>Nuevo Producto</button>
    </div>

    @if (currentView == "lista")
    {
        <!-- Search bar -->
        <div class="search-filter-bar">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Buscar por nombre, tipo o marca..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       @bind:after="ApplyFilters" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="clear-btn" @onclick="ClearSearch" title="Limpiar búsqueda">×</button>
                }
            </div>
            <div class="filter-buttons">
                <div class="filter-info">
                    Mostrando <strong>@productosFiltrados.Count</strong> de <strong>@productos.Count</strong> productos
                </div>
            </div>
        </div>

        <!-- Products table -->
        <div class="productos-table-container">
            <table class="productos-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Nombre</th>
                        <th style="width: 120px;">Tipo</th>
                        <th style="width: 120px;">Marca</th>
                        <th style="width: 120px;">Precio Venta</th>
                        <th style="width: 130px;">Fecha Entrada</th>
                        <th style="width: 140px;">Stock (Rec/Disp)</th>
                        <th style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (productosFiltrados != null && productosFiltrados.Any())
                    {
                        @foreach (var producto in productosFiltrados)
                        {
                            <tr>
                                <td class="text-center"><strong>@producto.Id_Pro</strong></td>
                                <td><strong>@producto.Nom_Pro</strong></td>
                                <td><span class="tipo-badge @(producto.Tip_Pro == "Bien" ? "bien" : "servicio")">@producto.Tip_Pro</span></td>
                                <td>@producto.Marca</td>
                                <td class="precio-col">@producto.Precio_Venta.ToString("C")</td>
                                <td class="text-center">
                                    @if (producto.Lotes != null && producto.Lotes.Any())
                                    {
                                        @producto.Lotes.First().Fec_Ent.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span style="color: #999;">-</span>
                                    }
                                </td>
                                <td class="stock-col">
                                    @if (producto.Lotes != null && producto.Lotes.Any())
                                    {
                                        var totalRecibido = producto.Lotes.Sum(l => l.Cantidad_Recibida);
                                        var totalDisponible = producto.Lotes.Sum(l => l.Cantidad_Disponible);
                                        <span>@totalRecibido / @totalDisponible</span>
                                    }
                                    else
                                    {
                                        <span>0 / 0</span>
                                    }
                                </td>
                                <td class="actions-col">
                                    <button class="action-btn-icon view" @onclick='() => VerProducto(producto.Id_Pro)' title="Ver">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                    <button class="action-btn-icon edit" @onclick='() => EditarProducto(producto.Id_Pro)' title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button class="action-btn-icon delete" @onclick='() => EliminarProducto(producto.Id_Pro)' title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="no-data">
                                    <div class="empty-state">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                        </svg>
                                        <p>No se encontraron productos</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (currentView == "nuevo")
    {
        <div class="content-section">
            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">Nuevo Producto</h3>
                    <p class="form-subtitle">Complete la información del producto</p>
                </div>
                <ProductoForm Model="productoActual" OnGuardar="GuardarProducto" OnCancelar='() => ChangeView("lista")' />
            </div>
        </div>
    }
</div>

@code {
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private string searchTerm = string.Empty;
    private string currentView = "lista";
    private Producto productoActual = new();

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var filtered = productos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filtered = filtered.Where(p =>
                p.Nom_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Tip_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Marca.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        productosFiltrados = filtered.ToList();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        ApplyFilters();
    }

    private void ChangeView(string view)
    {
        currentView = view;
        if (view == "nuevo")
        {
            productoActual = new Producto();
        }
    }

    private async Task GuardarProducto()
    {
        if (productoActual.Id_Pro == 0)
        {
            await ProductoService.CreateProductoAsync(productoActual);
        }
        else
        {
            await ProductoService.UpdateProductoAsync(productoActual);
        }
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
        ChangeView("lista");
    }

    private void VerProducto(int id)
    {
        Console.WriteLine($"Ver producto: {id}");
    }

    private async Task EditarProducto(int id)
    {
        var producto = await ProductoService.GetProductoByIdAsync(id);
        if (producto != null)
        {
            productoActual = producto;
            currentView = "nuevo";
        }
    }

    private async Task EliminarProducto(int id)
    {
        await ProductoService.DeleteProductoAsync(id);
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
    }
}
