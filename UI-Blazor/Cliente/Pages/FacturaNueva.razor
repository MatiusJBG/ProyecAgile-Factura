@page "/facturas/nueva"
@using UI_Blazor.Client.Services
@using UI_Blazor.Client.Models
@using Cliente.Components
@using FacturaModel = UI_Blazor.Client.Models.Factura
@inject FacturaService FacturaService
@inject NavigationManager Nav

<div class="factura-nueva-page">
    <FacturaForm Factura="@factura" 
                 OnGuardar="@GuardarFactura" 
                 OnCancelar="@Cancelar" />
</div>

@code {
    private FacturaModel factura = new()
    {
        Fec_Fac = DateTime.Today,
        Detalles = new List<DetalleFactura> { new DetalleFactura() }
    };

    private async Task GuardarFactura()
    {
        try
        {
            await FacturaService.CreateAsync(factura);
            Nav.NavigateTo("/facturas");
        }
        catch (Exception ex)
        {
            // In a real app we would show a toast notification here
            Console.WriteLine($"Error al guardar factura: {ex.Message}");
        }
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/facturas");
    }
}
