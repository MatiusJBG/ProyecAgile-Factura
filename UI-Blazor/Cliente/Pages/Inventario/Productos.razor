@page "/productos"
@page "/productos/lista"
@attribute [Authorize]
@using Application.DTOs.Producto

@using Cliente.Components
@using Cliente.Services.Inventario


@inject Cliente.Services.Inventario.IProductoService ProductoService
@inject Cliente.Services.Inventario.IDescuentoService DescuentoService
@inject NavigationManager NavigationManager

<PageTitle>Productos</PageTitle>

<div class="productos-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-title-section">
            <h2 class="page-title">Gestión de Productos</h2>
            <p class="page-subtitle">Administra tu catálogo de productos y servicios</p>
        </div>
    </div>

    <!-- Tab navigation -->
    <div class="tabs-navigation">
        <button class="tab-btn @(currentView == "lista" ? "active" : "")" @onclick='() => ChangeView("lista")'>Lista General</button>
        <button class="tab-btn @(currentView == "nuevo" ? "active" : "")" @onclick='() => ChangeView("nuevo")'>Nuevo Producto</button>
        @if (productoParaEditar != null)
        {
            <button class="tab-btn active" @onclick='() => ChangeView("editar")'>
                Editar Producto
            </button>
        }
        <button class="tab-btn @(currentView == "descuentos" ? "active" : "")" @onclick='() => ChangeView("descuentos")'>Descuentos</button>
    </div>

    @if (currentView == "lista")
    {
                    <!-- Tabla de Productos (Componente Extraido con Paginacion) -->
            <ProductoTable Productos="productosPaginaActual"
                           CurrentPage="currentPage"
                           TotalPages="totalPages"
                           OnPageChanged="CambiarPagina"
                           OnView="VerProductoDto"
                           OnEdit="EditarProductoDto"
                           OnDelete="EliminarProductoDto"
                           OnAddBatch="AgregarLote">
                <ToolBarContent>
                     <!-- Search bar -->
                    <div class="search-filter-bar compact">
                        <div class="search-box">
                            <span class="search-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                            </span>
                            <input type="text"
                                   class="search-input has-icon"
                                   placeholder="Buscar por nombre, tipo o marca..."
                                   @bind="searchTerm"
                                   @bind:event="oninput"
                                   @bind:after="ApplyFilters" />
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <button class="clear-btn" @onclick="ClearSearch" title="Limpiar búsqueda">✕</button>
                            }
                        </div>
                        <div class="filter-buttons">
                            <div class="filter-info">
                                <strong>@productosFiltrados.Count</strong> / <strong>@productos.Count</strong>
                            </div>
                        </div>
                    </div>
                </ToolBarContent>
            </ProductoTable>

    }
    else if (currentView == "nuevo")
    {
        <div class="content-section">
            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">Nuevo Producto</h3>
                    <p class="form-subtitle">Complete la información del producto</p>
                </div>
                <ProductoForm Model="productoActual" OnGuardar="GuardarProductoDto" OnCancelar='() => ChangeView("lista")' />
            </div>
        </div>
    }
        else if (currentView == "editar" && productoParaEditar != null)
    {
         <div class="content-section">
             <div class="form-container">
                 <div class="form-header">
                     <h3 class="form-title">Editar Producto</h3>
                     <p class="form-subtitle">Modificando: @productoParaEditar.Nom_Pro</p>
                 </div>
                 <ProductoForm Model="productoParaEditar" OnGuardar="HandleSubmitEditProduct" OnCancelar="CancelarEdicion" />
             </div>
         </div>
    }
    else if (currentView == "descuentos")
    {
        <div class="content-section">
            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">Gestión de Descuentos</h3>
                    <p class="form-subtitle">Asigne y administre descuentos para sus productos</p>
                </div>
                
                <!-- 1. BUSCADOR DE PRODUCTO (AUTOCOMPLETE) -->
                <div class="discount-selector-section">
                    <div class="form-group search-container-discount">
                        <label class="form-label">Buscar Producto (Caché Local)</label>
                        <div class="autocomplete-wrapper">
                            <span class="search-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                            </span>
                            <input type="text" 
                                   class="search-input-discount has-icon" 
                                   placeholder="Escribe para buscar..." 
                                   @bind="searchTermDescuento" 
                                   @bind:event="oninput"
                                   @onkeyup="FiltrarProductosDescuento" 
                                   @onfocusout="OcultarResultadosDescuento" />
                            
                            @if (mostrarResultadosDescuento && productosFiltradosDescuento.Any())
                            {
                                <ul class="autocomplete-results">
                                    @foreach (var prod in productosFiltradosDescuento)
                                    {
                                        <li @onclick="() => SeleccionarProductoDescuento(prod)" @onmousedown:preventDefault>
                                            <span class="result-name">@prod.Nom_Pro</span>
                                            <span class="result-brand">@prod.Marca</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (mostrarResultadosDescuento && !string.IsNullOrEmpty(searchTermDescuento))
                            {
                                <div class="autocomplete-no-results">
                                    No se encontraron productos
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 2. FORMULARIO Y TABLA DEL PRODUCTO SELECCIONADO -->
                @if (productoSeleccionadoDescuento != null)
                {
                    <div class="selected-product-section">
                        <h4 class="section-title">Descuentos para: <strong>@productoSeleccionadoDescuento.Nom_Pro</strong></h4>
                        
                        <!-- Formulario Nuevo Descuento -->
                        <div class="new-discount-form">
                            <h5 class="form-section-label">Agregar Nuevo Descuento</h5>
                            <div class="discount-form-grid">
                                <div class="form-group">
                                    <label>Porcentaje (%)</label>
                                    <input type="number" class="form-control" @bind="nuevoDescuento.Porcentaje" min="0" max="100" />
                                </div>
                                <div class="form-group">
                                    <label>Motivo</label>
                                    <input type="text" class="form-control" @bind="nuevoDescuento.Motivo" placeholder="Ej. Oferta Verano" />
                                </div>
                                <div class="form-group">
                                    <label>Fecha Fin (Opcional)</label>
                                    <input type="date" class="form-control" @bind="nuevoDescuento.FechaFin" />
                                </div>
                                <div class="form-group align-end">
                                    <button class="btn-primary" @onclick="GuardarDescuento">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M12 8a.5.5 0 0 1-.5.5h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0v3h3a.5.5 0 0 1 .5.5z"/>
                                        </svg>
                                        Agregar
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de Descuentos del Producto -->
                        <div class="product-discounts-table">
                            <table class="descuentos-table">
                                <thead>
                                    <tr>
                                        <th>Motivo</th>
                                        <th>%</th>
                                        <th>Inicio</th>
                                        <th>Fin</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (descuentosProductoDto.Any())
                                    {
                                        @foreach (var desc in descuentosProductoDto)
                                        {
                                            <tr>
                                                <td>@desc.Motivo</td>
                                                <td><span class="badge-percentage">@desc.Porcentaje%</span></td>
                                                <td>@desc.FechaInicio.ToShortDateString()</td>
                                                <td>@(desc.FechaFin?.ToShortDateString() ?? "-")</td>
                                                <td>
                                                    <span class="status-badge @(desc.Activo ? "active" : "inactive")">
                                                        @(desc.Activo ? "Activo" : "Inactivo")
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <button class="action-btn delete" @onclick="() => EliminarDescuento(desc.Id_Desc)" title="Eliminar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                          <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                          <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                        </svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="no-data">No hay descuentos configurados para este producto</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <hr class="section-divider" />

                <!-- 3. TABLA DE TODOS LOS DESCUENTOS ACTIVOS (CON PAGINACIÓN) -->
                <div class="all-discounts-section">
                    <h4 class="section-title">Todos los Descuentos Activos</h4>
                    
                    @if (descuentosPaginados.Any())
                    {
                        <div class="descuentos-table-container">
                            <table class="descuentos-table">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Motivo</th>
                                        <th>Descuento %</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Estado</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var desc in descuentosPaginados)
                                    {
                                        var producto = productos.FirstOrDefault(p => p.Id_Pro == desc.Id_Pro_Per);
                                        <tr>
                                            <td><strong>@(producto?.Nom_Pro ?? "Producto no encontrado")</strong></td>
                                            <td>@desc.Motivo</td>
                                            <td><span class="badge-percentage">@desc.Porcentaje%</span></td>
                                            <td>@desc.FechaInicio.ToShortDateString()</td>
                                            <td>@(desc.FechaFin?.ToShortDateString() ?? "Sin límite")</td>
                                            <td>
                                                <span class="status-badge @(desc.Activo ? "active" : "inactive")">
                                                    @(desc.Activo ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button class="action-btn delete" @onclick="() => EliminarDescuentoGlobal(desc.Id_Desc)" title="Eliminar">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                      <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                      <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        <div class="pagination-controls">
                            <div class="pagination-info">
                                Mostrando @((descuentosCurrentPage - 1) * descuentosPageSize + 1) - @(Math.Min(descuentosCurrentPage * descuentosPageSize, todosLosDescuentos.Count)) de @todosLosDescuentos.Count descuentos
                            </div>
                            <div class="pagination-buttons">
                                <button class="pagination-btn prev-next" @onclick="() => CambiarPaginaDescuentos(descuentosCurrentPage - 1)" disabled="@(descuentosCurrentPage == 1)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
                                    </svg>
                                </button>

                                @foreach (var p in GetDescuentosPageNumbers())
                                {
                                    @if (p == -1)
                                    {
                                        <span class="pagination-ellipsis">...</span>
                                    }
                                    else
                                    {
                                        <button class="pagination-btn number @(p == descuentosCurrentPage ? "active" : "")" 
                                                @onclick="() => CambiarPaginaDescuentos(p)">
                                            @p
                                        </button>
                                    }
                                }

                                <button class="pagination-btn prev-next" @onclick="() => CambiarPaginaDescuentos(descuentosCurrentPage + 1)" disabled="@(descuentosCurrentPage == descuentosTotalPages)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                            </svg>
                            <p>No hay descuentos activos actualmente</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    <!-- Modal Ver Producto -->
    @if (showViewModal)
    {
        <div class="modal-overlay" @onclick="CerrarModalVer">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Detalles del Producto</h3>
                    <button class="modal-close-btn" @onclick="CerrarModalVer">×</button>
                </div>
                <div class="modal-body">
                    @if (productoParaVer != null)
                    {
                        <div class="producto-detalle-grid">
                            <div class="detalle-item">
                                <label>ID:</label>
                                <span>@productoParaVer.Id_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Nombre:</label>
                                <span>@productoParaVer.Nom_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Tipo:</label>
                                <span class="tipo-badge @(productoParaVer.Tip_Pro == "Bien" ? "bien" : "servicio")">@productoParaVer.Tip_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Marca:</label>
                                <span>@productoParaVer.Marca</span>
                            </div>
                            <div class="detalle-item">
                                <label>Precio de Venta:</label>
                                <span class="precio-detalle">@productoParaVer.Precio_Venta.ToString("C")</span>
                            </div>
                            <div class="detalle-item">
                                <label>Stock Total:</label>
                                <span>@productoParaVer.StockTotal</span>
                            </div>
                            <div class="detalle-item">
                                <label>Número de Lotes:</label>
                                <span>@productoParaVer.NumLotes</span>
                            </div>
                            @if (productoParaVer.Imagen != null)
                            {
                                <div class="detalle-item full-width">
                                    <label>Imagen:</label>
                                    <span>@productoParaVer.Imagen</span>
                                </div>
                            }
                            
                            @if (productoParaVer.Lotes != null && productoParaVer.Lotes.Any())
                            {
                                <div class="detalle-item full-width">
                                    <label>Lotes:</label>
                                    <div class="lotes-tabla">
                                        <table class="lotes-mini-table">
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Fecha Entrada</th>
                                                    <th>Fecha Expiración</th>
                                                    <th>Cantidad Recibida</th>
                                                    <th>Cantidad Disponible</th>
                                                    <th>Precio Unitario</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var lote in productoParaVer.Lotes)
                                                {
                                                    <tr>
                                                        <td>@lote.Id_Lote</td>
                                                        <td>@lote.Fec_Ent.ToString("dd/MM/yyyy")</td>
                                                        <td>@lote.Fec_Exp.ToString("dd/MM/yyyy")</td>
                                                        <td>@lote.Cantidad_Recibida</td>
                                                        <td>@lote.Cantidad_Disponible</td>
                                                        <td>@lote.Precio_Unitario.ToString("C")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CerrarModalVer">Cerrar</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Agregar Lote -->
    @if (showAddBatchModal)
    {
        <div class="modal-overlay" @onclick="CerrarModalLote">
            <div class="modal-content modal-edit" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Agregar Lote a @productoParaLote?.Nom_Pro</h3>
                    <button class="modal-close-btn" @onclick="CerrarModalLote">×</button>
                </div>
                <div class="modal-body">
                    <div class="form-edit-grid">
                        <div class="form-group">
                            <label>Fecha de Entrada:</label>
                            <input type="date" class="form-control" @bind="nuevoLote.Fec_Ent" />
                        </div>
                        <div class="form-group">
                            <label>Fecha de Expiración:</label>
                            <input type="date" class="form-control" @bind="nuevoLote.Fec_Exp" />
                        </div>
                        <div class="form-group">
                            <label>Cantidad Recibida:</label>
                            <input type="number" class="form-control" @bind="nuevoLote.Cantidad_Recibida" min="1" />
                        </div>
                        <div class="form-group">
                            <label>Costo Unitario:</label>
                            <input type="number" step="0.01" class="form-control" @bind="nuevoLote.Precio_Unitario" min="0" />
                        </div>
                        <div class="form-group">
                            <label>Cantidad Disponible (Inicial):</label>
                            <input type="number" class="form-control" @bind="nuevoLote.Cantidad_Disponible" min="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CerrarModalLote">Cancelar</button>
                    <button class="btn-primary" @onclick="GuardarLote">Guardar Lote</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductoDto> productos = new();
    private List<ProductoDto> productosPaginaActual = new();
    
    // Paginacion
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private List<ProductoDto> productosFiltrados = new();
    private string searchTerm = string.Empty;
    private string currentView = "lista";
    private ProductoDto productoActual = new();

    // Variables para modales
    private bool showViewModal = false;
    private ProductoDto? productoParaVer;
    private ProductoDto? productoParaEditar;
    
    // Variables para agregar lote
    private bool showAddBatchModal = false;
    private ProductoDto? productoParaLote;
    private LoteDto nuevoLote = new();

    // Variables para descuentos
    private ProductoDto? productoSeleccionadoDescuento;
    private List<DescuentoProductoDto> descuentosProductoDto = new();
    private List<DescuentoProductoDto> todosLosDescuentos = new();
    private DescuentoProductoDto nuevoDescuento = new();

    // Variables para buscador de descuentos
    private string searchTermDescuento = "";
    private List<ProductoDto> productosFiltradosDescuento = new();
    private bool mostrarResultadosDescuento = false;

    private void FiltrarProductosDescuento()
    {
        if (string.IsNullOrWhiteSpace(searchTermDescuento))
        {
            productosFiltradosDescuento = new();
            mostrarResultadosDescuento = false;
        }
        else
        {
            productosFiltradosDescuento = productos
                .Where(p => p.Nom_Pro.Contains(searchTermDescuento, StringComparison.OrdinalIgnoreCase) ||
                            p.Marca.Contains(searchTermDescuento, StringComparison.OrdinalIgnoreCase))
                .Take(10) // Limitar resultados
                .ToList();
            mostrarResultadosDescuento = true;
        }
    }

    private async Task SeleccionarProductoDescuento(ProductoDto producto)
    {
        productoSeleccionadoDescuento = producto;
        searchTermDescuento = producto.Nom_Pro; 
        mostrarResultadosDescuento = false;
        
        await CargarDescuentos(producto.Id_Pro);
        nuevoDescuento = new DescuentoProductoDto { Id_Pro_Per = producto.Id_Pro, Activo = true, FechaInicio = DateTime.Today };
    }

    private async Task OcultarResultadosDescuento()
    {
        // Pequeño delay para permitir el click en el item
        await Task.Delay(200);
        mostrarResultadosDescuento = false;
    }

    // Variables para paginación de descuentos
    private int descuentosCurrentPage = 1;
    private int descuentosPageSize = 5;
    private int descuentosTotalPages = 1;

    private List<DescuentoProductoDto> descuentosPaginados => 
        todosLosDescuentos != null 
            ? todosLosDescuentos
                .Skip((descuentosCurrentPage - 1) * descuentosPageSize)
                .Take(descuentosPageSize)
                .ToList() 
            : new List<DescuentoProductoDto>();

    private void CambiarPaginaDescuentos(int pagina)
    {
        if (pagina < 1 || pagina > descuentosTotalPages) return;
        descuentosCurrentPage = pagina;
        StateHasChanged();
    }

    private List<int> GetDescuentosPageNumbers()
    {
        var pages = new List<int>();
        for (int i = 1; i <= descuentosTotalPages; i++)
        {
            pages.Add(i);
        }
        return pages;
    }

    private void RecalcularPaginacionDescuentos()
    {
        descuentosTotalPages = (int)Math.Ceiling((double)todosLosDescuentos.Count / descuentosPageSize);
        if (descuentosTotalPages < 1) descuentosTotalPages = 1;
        if (descuentosCurrentPage > descuentosTotalPages) descuentosCurrentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var filtered = productos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filtered = filtered.Where(p =>
                p.Nom_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Tip_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Marca.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        productosFiltrados = filtered.ToList();
        
        // Update Pagination
        totalPages = (int)Math.Ceiling(productosFiltrados.Count / (double)pageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = 1;
        
        UpdateCurrentPageData();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        ApplyFilters();
    }

