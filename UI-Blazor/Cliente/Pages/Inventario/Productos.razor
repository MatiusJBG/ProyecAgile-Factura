        await CargarDescuentos(nuevoDescuento.Id_Pro_Per);
        
        // Recargar la tabla superior de todos los descuentos
        // Recargar la tabla superior de todos los descuentos
        todosLosDescuentos = await DescuentoService.GetAllDescuentosAsync();
        RecalcularPaginacionDescuentos();
        
