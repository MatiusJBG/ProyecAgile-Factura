    private async Task AgregarLote(int id)
    {
        var producto = await ProductoService.GetProductoByIdAsync(id);
        if (producto != null)
        {
            productoParaLote = producto;
            nuevoLote = new LoteDto 
            { 
                Id_Pro_Per = id,
                Fec_Ent = DateTime.Today,
                Fec_Exp = DateTime.Today.AddMonths(1),
                Cantidad_Recibida = 0,
                Cantidad_Disponible = 0,
                Precio_Unitario = 0
            };
            showAddBatchModal = true;
        }
    }

    private void CerrarModalLote()
    {
        showAddBatchModal = false;
        productoParaLote = null;
    }

    private async Task GuardarLote()
    {
        if (nuevoLote.Cantidad_Recibida <= 0)
        {
            // Validar
            return;
        }

        // Si cantidad disponible es 0, asumir que es igual a la recibida
        if (nuevoLote.Cantidad_Disponible == 0)
        {
            nuevoLote.Cantidad_Disponible = nuevoLote.Cantidad_Recibida;
        }

        await ProductoService.AddLoteAsync(nuevoLote.Id_Pro_Per, nuevoLote);
        
        // Recargar
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
        
        CerrarModalLote();
    }

    
    // PAGINATION LOGIC
    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > totalPages) return;
        currentPage = nuevaPagina;
        UpdateCurrentPageData();
    }
    
    private void UpdateCurrentPageData()
    {
        productosPaginaActual = productosFiltrados
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

