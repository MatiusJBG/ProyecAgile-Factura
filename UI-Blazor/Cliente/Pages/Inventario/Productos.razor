@page "/productos"
@page "/productos/lista"
@attribute [Authorize]
@using Application.DTOs.Producto

@using Cliente.Components


@inject IProductoService ProductoService
@inject IDescuentoService DescuentoService
@inject NavigationManager NavigationManager

<PageTitle>ProductoDtos</PageTitle>

<div class="productos-page">
    <!-- Header -->
    <div class="page-header">
        <div class="header-title-section">
            <h2 class="page-title">Gestión de ProductoDtos</h2>
            <p class="page-subtitle">Administra tu catálogo de productos y servicios</p>
        </div>
    </div>

    <!-- Tab navigation -->
    <div class="tabs-navigation">
        <button class="tab-btn @(currentView == "lista" ? "active" : "")" @onclick='() => ChangeView("lista")'>Lista General</button>
        <button class="tab-btn @(currentView == "nuevo" ? "active" : "")" @onclick='() => ChangeView("nuevo")'>Nuevo ProductoDto</button>
        <button class="tab-btn @(currentView == "descuentos" ? "active" : "")" @onclick='() => ChangeView("descuentos")'>Descuentos</button>
    </div>

    @if (currentView == "lista")
    {
        <!-- Search bar -->
        <div class="search-filter-bar">
            <div class="search-box">
                <input type="text"
                       class="search-input"
                       placeholder="Buscar por nombre, tipo o marca..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       @bind:after="ApplyFilters" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button class="clear-btn" @onclick="ClearSearch" title="Limpiar búsqueda">×</button>
                }
            </div>
            <div class="filter-buttons">
                <div class="filter-info">
                    Mostrando <strong>@productosFiltrados.Count</strong> de <strong>@productos.Count</strong> productos
                </div>
            </div>
        </div>

        <!-- Products table -->
        <div class="productos-table-container">
            <table class="productos-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Nombre</th>
                        <th style="width: 120px;">Tipo</th>
                        <th style="width: 120px;">Marca</th>
                        <th style="width: 120px;">Precio Venta</th>
                        <th style="width: 130px;">Fecha Entrada</th>
                        <th style="width: 140px;">Stock (Rec/Disp)</th>
                        <th style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (productosFiltrados != null && productosFiltrados.Any())
                    {
                        @foreach (var producto in productosFiltrados)
                        {
                            <tr>
                                <td class="text-center"><strong>@producto.Id_Pro</strong></td>
                                <td><strong>@producto.Nom_Pro</strong></td>
                                <td><span class="tipo-badge @(producto.Tip_Pro == "Bien" ? "bien" : "servicio")">@producto.Tip_Pro</span></td>
                                <td>@producto.Marca</td>
                                <td class="precio-col">@producto.Precio_Venta.ToString("C")</td>
                                <td class="text-center">
                                    @if (producto.Lotes != null && producto.Lotes.Any())
                                    {
                                        @producto.Lotes.First().Fec_Ent.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span style="color: #999;">-</span>
                                    }
                                </td>
                                <td class="stock-col">
                                    @if (producto.Lotes != null && producto.Lotes.Any())
                                    {
                                        var totalRecibido = producto.Lotes.Sum(l => l.Cantidad_Recibida);
                                        var totalDisponible = producto.Lotes.Sum(l => l.Cantidad_Disponible);
                                        <span>@totalRecibido / @totalDisponible</span>
                                    }
                                    else
                                    {
                                        <span>0 / 0</span>
                                    }
                                </td>
                                <td class="actions-col">
                                    <button class="action-btn-icon view" @onclick='() => VerProductoDto(producto.Id_Pro)' title="Ver">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </button>
                                    <button class="action-btn-icon edit" @onclick='() => EditarProductoDto(producto.Id_Pro)' title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <button class="action-btn-icon delete" @onclick='() => EliminarProductoDto(producto.Id_Pro)' title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                    <button class="action-btn-icon add-batch" @onclick='() => AgregarLote(producto.Id_Pro)' title="Agregar Lote">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                            <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="no-data">
                                    <div class="empty-state">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                        </svg>
                                        <p>No se encontraron productos</p>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (currentView == "nuevo")
    {
        <div class="content-section">
            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">Nuevo ProductoDto</h3>
                    <p class="form-subtitle">Complete la información del producto</p>
                </div>
                <ProductoForm Model="productoActual" OnGuardar="GuardarProductoDto" OnCancelar='() => ChangeView("lista")' />
            </div>
        </div>
    }
    else if (currentView == "descuentos")
    {
        <div class="content-section">
            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">Gestión de Descuentos</h3>
                    <p class="form-subtitle">Asigne descuentos a sus productos</p>
                </div>
                
                <!-- Tabla de productos con descuentos activos -->
                <div class="descuentos-activos-section mb-4">
                    <h4>ProductoDtos con Descuentos Activos</h4>
                    @if (todosLosDescuentos.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ProductoDto</th>
                                    <th>Motivo</th>
                                    <th>Descuento %</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var desc in todosLosDescuentos)
                                {
                                    var producto = productos.FirstOrDefault(p => p.Id_Pro == desc.Id_Pro_Per);
                                    <tr>
                                        <td><strong>@(producto?.Nom_Pro ?? "ProductoDto no encontrado")</strong></td>
                                        <td>@desc.Motivo</td>
                                        <td><span class="badge bg-success">@desc.Porcentaje%</span></td>
                                        <td>@desc.FechaInicio.ToShortDateString()</td>
                                        <td>@(desc.FechaFin?.ToShortDateString() ?? "Sin límite")</td>
                                        <td>
                                            <span class="badge @(desc.Activo ? "bg-success" : "bg-secondary")">
                                                @(desc.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarDescuentoGlobal(desc.Id_Desc)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                  <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                  <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No hay productos con descuentos activos actualmente.
                        </div>
                    }
                </div>

                <hr class="my-4" />
                
                <div class="descuento-form-grid">
                    <div class="form-group">
                        <label>ProductoDto</label>
                        <select class="form-control" @onchange="OnProductoDtoDescuentoChanged">
                            <option value="">Seleccione un producto...</option>
                            @foreach (var prod in productos)
                            {
                                <option value="@prod.Id_Pro">@prod.Nom_Pro</option>
                            }
                        </select>
                    </div>
                </div>

                @if (productoSeleccionadoDescuento != null)
                {
                    <div class="descuentos-list-section mt-4">
                        <h4>Descuentos para: @productoSeleccionadoDescuento.Nom_Pro</h4>
                        
                        <!-- Formulario Nuevo Descuento -->
                        <div class="new-discount-box p-3 border rounded mb-3 bg-light">
                            <h5>Agregar Nuevo Descuento</h5>
                            <div class="row">
                                <div class="col-md-3">
                                    <label>Porcentaje (%)</label>
                                    <input type="number" class="form-control" @bind="nuevoDescuento.Porcentaje" min="0" max="100" />
                                </div>
                                <div class="col-md-4">
                                    <label>Motivo</label>
                                    <input type="text" class="form-control" @bind="nuevoDescuento.Motivo" placeholder="Ej. Oferta Verano" />
                                </div>
                                <div class="col-md-3">
                                    <label>Fecha Fin (Opcional)</label>
                                    <input type="date" class="form-control" @bind="nuevoDescuento.FechaFin" />
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button class="btn btn-primary w-100" @onclick="GuardarDescuento">Agregar</button>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de Descuentos Existentes -->
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Motivo</th>
                                    <th>%</th>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var desc in descuentosProductoDto)
                                {
                                    <tr>
                                        <td>@desc.Motivo</td>
                                        <td>@desc.Porcentaje%</td>
                                        <td>@desc.FechaInicio.ToShortDateString()</td>
                                        <td>@(desc.FechaFin?.ToShortDateString() ?? "-")</td>
                                        <td>
                                            <span class="badge @(desc.Activo ? "bg-success" : "bg-secondary")">
                                                @(desc.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarDescuento(desc.Id_Desc)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                  <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                  <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Modal Ver ProductoDto -->
    @if (showViewModal)
    {
        <div class="modal-overlay" @onclick="CerrarModalVer">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Detalles del ProductoDto</h3>
                    <button class="modal-close-btn" @onclick="CerrarModalVer">×</button>
                </div>
                <div class="modal-body">
                    @if (productoParaVer != null)
                    {
                        <div class="producto-detalle-grid">
                            <div class="detalle-item">
                                <label>ID:</label>
                                <span>@productoParaVer.Id_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Nombre:</label>
                                <span>@productoParaVer.Nom_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Tipo:</label>
                                <span class="tipo-badge @(productoParaVer.Tip_Pro == "Bien" ? "bien" : "servicio")">@productoParaVer.Tip_Pro</span>
                            </div>
                            <div class="detalle-item">
                                <label>Marca:</label>
                                <span>@productoParaVer.Marca</span>
                            </div>
                            <div class="detalle-item">
                                <label>Precio de Venta:</label>
                                <span class="precio-detalle">@productoParaVer.Precio_Venta.ToString("C")</span>
                            </div>
                            <div class="detalle-item">
                                <label>Stock Total:</label>
                                <span>@productoParaVer.StockTotal</span>
                            </div>
                            <div class="detalle-item">
                                <label>Número de Lotes:</label>
                                <span>@productoParaVer.NumLotes</span>
                            </div>
                            @if (productoParaVer.Imagen != null)
                            {
                                <div class="detalle-item full-width">
                                    <label>Imagen:</label>
                                    <span>@productoParaVer.Imagen</span>
                                </div>
                            }
                            
                            @if (productoParaVer.Lotes != null && productoParaVer.Lotes.Any())
                            {
                                <div class="detalle-item full-width">
                                    <label>Lotes:</label>
                                    <div class="lotes-tabla">
                                        <table class="lotes-mini-table">
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Fecha Entrada</th>
                                                    <th>Fecha Expiración</th>
                                                    <th>Cantidad Recibida</th>
                                                    <th>Cantidad Disponible</th>
                                                    <th>Precio Unitario</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var lote in productoParaVer.Lotes)
                                                {
                                                    <tr>
                                                        <td>@lote.Id_Lote</td>
                                                        <td>@lote.Fec_Ent.ToString("dd/MM/yyyy")</td>
                                                        <td>@lote.Fec_Exp.ToString("dd/MM/yyyy")</td>
                                                        <td>@lote.Cantidad_Recibida</td>
                                                        <td>@lote.Cantidad_Disponible</td>
                                                        <td>@lote.Precio_Unitario.ToString("C")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CerrarModalVer">Cerrar</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Editar ProductoDto -->
    @if (showEditModal)
    {
        <div class="modal-overlay" @onclick="CerrarModalEditar">
            <div class="modal-content modal-edit" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Editar ProductoDto</h3>
                    <button class="modal-close-btn" @onclick="CerrarModalEditar">×</button>
                </div>
                <div class="modal-body">
                    @if (productoParaEditar != null)
                    {
                        <div class="form-edit-grid">
                            <div class="form-group">
                                <label>ID:</label>
                                <input type="text" class="form-control" value="@productoParaEditar.Id_Pro" disabled />
                            </div>
                            <div class="form-group">
                                <label>Nombre:</label>
                                <input type="text" class="form-control" @bind="productoParaEditar.Nom_Pro" />
                            </div>
                            <div class="form-group">
                                <label>Tipo:</label>
                                <select class="form-control" @bind="productoParaEditar.Tip_Pro">
                                    <option value="Bien">Bien</option>
                                    <option value="Servicio">Servicio</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Marca:</label>
                                <input type="text" class="form-control" @bind="productoParaEditar.Marca" />
                            </div>
                            <div class="form-group">
                                <label>Precio de Venta:</label>
                                <input type="number" step="0.01" class="form-control" @bind="productoParaEditar.Precio_Venta" />
                            </div>
                            <div class="form-group">
                                <label>Imagen URL:</label>
                                <input type="text" class="form-control" @bind="productoParaEditar.Imagen" />
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CerrarModalEditar">Cancelar</button>
                    <button class="btn-primary" @onclick="GuardarEdicion">Guardar Cambios</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal Agregar Lote -->
    @if (showAddBatchModal)
    {
        <div class="modal-overlay" @onclick="CerrarModalLote">
            <div class="modal-content modal-edit" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>Agregar Lote a @productoParaLote?.Nom_Pro</h3>
                    <button class="modal-close-btn" @onclick="CerrarModalLote">×</button>
                </div>
                <div class="modal-body">
                    <div class="form-edit-grid">
                        <div class="form-group">
                            <label>Fecha de Entrada:</label>
                            <input type="date" class="form-control" @bind="nuevoLote.Fec_Ent" />
                        </div>
                        <div class="form-group">
                            <label>Fecha de Expiración:</label>
                            <input type="date" class="form-control" @bind="nuevoLote.Fec_Exp" />
                        </div>
                        <div class="form-group">
                            <label>Cantidad Recibida:</label>
                            <input type="number" class="form-control" @bind="nuevoLote.Cantidad_Recibida" min="1" />
                        </div>
                        <div class="form-group">
                            <label>Costo Unitario:</label>
                            <input type="number" step="0.01" class="form-control" @bind="nuevoLote.Precio_Unitario" min="0" />
                        </div>
                        <div class="form-group">
                            <label>Cantidad Disponible (Inicial):</label>
                            <input type="number" class="form-control" @bind="nuevoLote.Cantidad_Disponible" min="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CerrarModalLote">Cancelar</button>
                    <button class="btn-primary" @onclick="GuardarLote">Guardar Lote</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductoDto> productos = new();
    private List<ProductoDto> productosFiltrados = new();
    private string searchTerm = string.Empty;
    private string currentView = "lista";
    private ProductoDto productoActual = new();

    // Variables para modales
    private bool showViewModal = false;
    private bool showEditModal = false;
    private ProductoDto? productoParaVer;
    private ProductoDto? productoParaEditar;
    
    // Variables para agregar lote
    private bool showAddBatchModal = false;
    private ProductoDto? productoParaLote;
    private LoteDto nuevoLote = new();

    // Variables para descuentos
    private ProductoDto? productoSeleccionadoDescuento;
    private List<DescuentoProductoDto> descuentosProductoDto = new();
    private List<DescuentoProductoDto> todosLosDescuentos = new();
    private DescuentoProductoDto nuevoDescuento = new();

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var filtered = productos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filtered = filtered.Where(p =>
                p.Nom_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Tip_Pro.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Marca.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
        productosFiltrados = filtered.ToList();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        ApplyFilters();
    }

    private async void ChangeView(string view)
    {
        Console.WriteLine($"[ChangeView] Cambiando a vista: {view}");
        currentView = view;
        if (view == "nuevo")
        {
            productoActual = new ProductoDto();
        }
        else if (view == "descuentos")
        {
            productoSeleccionadoDescuento = null;
            descuentosProductoDto.Clear();
            
            // Cargar todos los descuentos
            Console.WriteLine("[ChangeView] Cargando descuentos...");
            try
            {
                todosLosDescuentos = await DescuentoService.GetAllDescuentosAsync();
                Console.WriteLine($"[ChangeView] Descuentos cargados: {todosLosDescuentos.Count}");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ChangeView] Error cargando descuentos: {ex.Message}");
                todosLosDescuentos = new();
            }
        }
    }

    private async Task GuardarProductoDto()
    {
        if (productoActual.Id_Pro == 0)
        {
            await ProductoService.CreateProductoAsync(productoActual);
        }
        else
        {
            await ProductoService.UpdateProductoAsync(productoActual);
        }
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
        ChangeView("lista");
    }

    private async Task VerProductoDto(int id)
    {
        var producto = await ProductoService.GetProductoByIdAsync(id);
        if (producto != null)
        {
            productoParaVer = producto;
            showViewModal = true;
        }
    }

    private void CerrarModalVer()
    {
        showViewModal = false;
        productoParaVer = null;
    }

    private async Task EditarProductoDto(int id)
    {
        var producto = await ProductoService.GetProductoByIdAsync(id);
        if (producto != null)
        {
            // Crear una copia del producto para editar
            productoParaEditar = new ProductoDto
            {
                Id_Pro = producto.Id_Pro,
                Nom_Pro = producto.Nom_Pro,
                Tip_Pro = producto.Tip_Pro,
                Marca = producto.Marca,
                Precio_Venta = producto.Precio_Venta,
                Imagen = producto.Imagen,
                StockTotal = producto.StockTotal,
                NumLotes = producto.NumLotes,
                Lotes = producto.Lotes
            };
            showEditModal = true;
        }
    }

    private void CerrarModalEditar()
    {
        showEditModal = false;
        productoParaEditar = null;
    }

    private async Task GuardarEdicion()
    {
        if (productoParaEditar != null)
        {
            // Aquí se enviaría al backend cuando esté implementado
            await ProductoService.UpdateProductoAsync(productoParaEditar);
            
            // Recargar la lista
            productos = await ProductoService.GetProductosAsync();
            ApplyFilters();
            
            // Cerrar modal
            CerrarModalEditar();
        }
    }

    private async Task EliminarProductoDto(int id)
    {
        await ProductoService.DeleteProductoAsync(id);
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
    }

    // Lógica de Descuentos
    private async Task OnProductoDtoDescuentoChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idProductoDto))
        {
            productoSeleccionadoDescuento = productos.FirstOrDefault(p => p.Id_Pro == idProductoDto);
            if (productoSeleccionadoDescuento != null)
            {
                await CargarDescuentos(idProductoDto);
                nuevoDescuento = new DescuentoProductoDto { Id_Pro_Per = idProductoDto, Activo = true, FechaInicio = DateTime.Today };
            }
        }
        else
        {
            productoSeleccionadoDescuento = null;
            descuentosProductoDto.Clear();
        }
    }

    private async Task CargarDescuentos(int idProductoDto)
    {
        descuentosProductoDto = await DescuentoService.GetDescuentosPorProductoAsync(idProductoDto);
    }

    private async Task GuardarDescuento()
    {
        if (nuevoDescuento.Porcentaje <= 0 || string.IsNullOrWhiteSpace(nuevoDescuento.Motivo))
        {
            // Validar (podría mostrar alerta)
            return;
        }

        await DescuentoService.CreateDescuentoAsync(nuevoDescuento);
        await CargarDescuentos(nuevoDescuento.Id_Pro_Per);
        
        // Recargar la tabla superior de todos los descuentos
        todosLosDescuentos = await DescuentoService.GetAllDescuentosAsync();
        
        // Reset form pero mantener producto
        var idProd = nuevoDescuento.Id_Pro_Per;
        nuevoDescuento = new DescuentoProductoDto { Id_Pro_Per = idProd, Activo = true, FechaInicio = DateTime.Today };
    }

    private async Task EliminarDescuento(int id)
    {
        await DescuentoService.DeleteDescuentoAsync(id);
        if (productoSeleccionadoDescuento != null)
        {
            await CargarDescuentos(productoSeleccionadoDescuento.Id_Pro);
        }
    }

    private async Task EliminarDescuentoGlobal(int id)
    {
        await DescuentoService.DeleteDescuentoAsync(id);
        
        // Recargar la tabla superior
        todosLosDescuentos = await DescuentoService.GetAllDescuentosAsync();
        
        // Si hay un producto seleccionado, recargar sus descuentos también
        if (productoSeleccionadoDescuento != null)
        {
            await CargarDescuentos(productoSeleccionadoDescuento.Id_Pro);
        }
        
        StateHasChanged();
    }

    private async Task AgregarLote(int id)
    {
        var producto = await ProductoService.GetProductoByIdAsync(id);
        if (producto != null)
        {
            productoParaLote = producto;
            nuevoLote = new LoteDto 
            { 
                Id_Pro_Per = id,
                Fec_Ent = DateTime.Today,
                Fec_Exp = DateTime.Today.AddMonths(1),
                Cantidad_Recibida = 0,
                Cantidad_Disponible = 0,
                Precio_Unitario = 0
            };
            showAddBatchModal = true;
        }
    }

    private void CerrarModalLote()
    {
        showAddBatchModal = false;
        productoParaLote = null;
    }

    private async Task GuardarLote()
    {
        if (nuevoLote.Cantidad_Recibida <= 0)
        {
            // Validar
            return;
        }

        // Si cantidad disponible es 0, asumir que es igual a la recibida
        if (nuevoLote.Cantidad_Disponible == 0)
        {
            nuevoLote.Cantidad_Disponible = nuevoLote.Cantidad_Recibida;
        }

        await ProductoService.AddLoteAsync(nuevoLote.Id_Pro_Per, nuevoLote);
        
        // Recargar
        productos = await ProductoService.GetProductosAsync();
        ApplyFilters();
        
        CerrarModalLote();
    }
}
