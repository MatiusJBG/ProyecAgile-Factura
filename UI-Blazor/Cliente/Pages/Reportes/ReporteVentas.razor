@using Application.DTOs.Reportes
@using Cliente.Services.Reportes
@inject IReporteService ReporteService

<div class="report-section">
    <h3 class="section-title">Reporte de Ventas e Inventario</h3>

    @if (IsLoading)
    {
        <div class="loading-spinner">Cargando reporte de ventas...</div>
    }
    else if (Reporte == null)
    {
        <div class="alert alert-warning">No se pudo cargar la información.</div>
    }
    else
    {
        <div class="cards-grid">
            <div class="summary-card">
                <div class="card-icon sales">
                   <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.91 8.84 8.56 2.23a1.93 1.93 0 0 0-1.81 0L3.1 4.13a2.12 2.12 0 0 0-.05 3.69l12.22 6.93a2 2 0 0 0 1.94 0L21 12.5a2.12 2.12 0 0 0-.09-3.66ZM3.81 7.24l3.11-1.63L16 10.45l-3.11 1.73ZM14.9 14l-11-6.16-1.12.63a1.14 1.14 0 0 0 1.14 1.95L14.9 16.5Zm3.33-1.61L17.15 13l-4.14 2.33v3.75a1.14 1.14 0 1 0 2.28 0v-2.11l2.94-1.63a1.14 1.14 0 1 0-1.11-2Zm0 0"/></svg>
                </div>
                <div class="card-content">
                    <span class="card-label">Total Ventas</span>
                    <span class="card-value">@Reporte.ResumenVentas.TotalVentas</span>
                    <span class="card-subtext">@Reporte.ResumenVentas.TotalIngresos.ToString("C2") ingresos</span>
                </div>
            </div>

            <div class="summary-card">
                <div class="card-icon inventory">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </div>
                <div class="card-content">
                    <span class="card-label">Valor Inventario</span>
                    <span class="card-value">@Reporte.InventarioGeneral.ValorTotalInventario.ToString("C2")</span>
                    <span class="card-subtext">@Reporte.InventarioGeneral.TotalItemsEnStock items en stock</span>
                </div>
            </div>

            <div class="summary-card @(Reporte.AlertasStock.Any() ? "alert-card" : "")">
                <div class="card-icon alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div class="card-content">
                    <span class="card-label">Alertas de Stock</span>
                    <span class="card-value">@Reporte.AlertasStock.Count</span>
                    <span class="card-subtext">Productos bajo mínimo</span>
                </div>
            </div>
        </div>

        <div class="details-grid">
            <div class="detail-panel">
                <h4>Top Productos Vendidos</h4>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Producto</th>
                            <th class="text-center">Cant.</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var prod in Reporte.TopProductos)
                        {
                            <tr>
                                <td>@prod.Ranking</td>
                                <td>@prod.NombreProducto</td>
                                <td class="text-center">@prod.CantidadVendida</td>
                                <td class="text-end">@prod.IngresoGenerado.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="detail-panel">
                <h4>Detalle de Alertas</h4>
                @if(Reporte.AlertasStock.Any())
                {
                     <ul class="alert-list">
                        @foreach(var alerta in Reporte.AlertasStock)
                        {
                            <li class="alert-item">
                                <span class="product-name">@alerta.NombreProducto</span>
                                <span class="stock-info">Stock: <b>@alerta.StockActual</b> (Min: @alerta.StockMinimo)</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                     <p class="text-muted">Inventario saludable.</p>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? FechaInicio { get; set; }
    [Parameter] public DateTime? FechaFin { get; set; }
    
    private ReporteVentasInventarioDto? Reporte;
    private bool IsLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

     private async Task LoadData()
    {
        IsLoading = true;
        try
        {
            Reporte = await ReporteService.GetReporteVentasInventarioAsync(FechaInicio, FechaFin);
        }
        catch(Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
