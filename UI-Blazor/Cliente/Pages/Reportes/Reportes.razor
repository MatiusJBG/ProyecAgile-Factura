@page "/reportes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Reportes - Facturación</PageTitle>

<div class="reports-container">
    <div class="header-section">
        <div class="title-block">
            <h1>Panel de Control</h1>
            <p class="subtitle">Visión general del estado financiero y operativo</p>
        </div>
        
        <div class="filter-bar">
            <div class="date-group">
                <label>Desde:</label>
                <input type="date" class="form-control" @bind="FechaInicio" />
            </div>
            <div class="date-group">
                <label>Hasta:</label>
                <input type="date" class="form-control" @bind="FechaFin" />
            </div>
            <button class="btn btn-primary btn-refresh" @onclick="UpdateReports">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                Actualizar
            </button>
        </div>
    </div>

    <div class="tabs-container">
        <div class="tabs-header">
            <button class="tab-btn @(ActiveTab == "financiero" ? "active" : "")" @onclick="@(() => SetTab("financiero"))">
                Control Financiero
            </button>
            <button class="tab-btn @(ActiveTab == "ventas" ? "active" : "")" @onclick="@(() => SetTab("ventas"))">
                Ventas e Inventario
            </button>
        </div>

        <div class="tab-content">
            @if (ActiveTab == "financiero")
            {
                <ReporteFinanciero FechaInicio="FechaInicio" FechaFin="FechaFin" />
            }
            else if (ActiveTab == "ventas")
            {
                <ReporteVentas FechaInicio="FechaInicio" FechaFin="FechaFin" />
            }
        </div>
    </div>
</div>

@code {
    private string ActiveTab = "financiero";
    private DateTime FechaInicio = DateTime.Today.AddDays(-30);
    private DateTime FechaFin = DateTime.Today;

    private void SetTab(string tab)
    {
        ActiveTab = tab;
    }

    private void UpdateReports()
    {
        // Force refresh by re-rendering components with new parameters
        // Blazor handles this automatically via Parameter updates
        StateHasChanged();
    }
}
