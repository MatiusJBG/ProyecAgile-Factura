@using UI_Blazor.Client.Services
@using UI_Blazor.Client.Models
@using FacturaModel = UI_Blazor.Client.Models.Factura
@using Models = UI_Blazor.Client.Models
@inject IClienteService ClienteService
@inject IProductoService ProductoService
@inject IDescuentoService DescuentoService

<div class="factura-form-container">
    <div class="form-header-section">
        <h3 class="modal-title">@(Factura.Id_Fac == 0 ? "Nueva Factura" : "Editar Factura")</h3>
        <p class="form-subtitle">Complete la información para generar una nueva factura electrónica.</p>
    </div>

    <EditForm Model="@Factura" OnValidSubmit="CalcularTotales">
        <DataAnnotationsValidator />
        
        <div class="form-sections">
            <!-- Sección 1: Información General -->
            <div class="form-section">
                <h4 class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                    Información General
                </h4>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label>Fecha de Emisión</label>
                        <InputDate @bind-Value="Factura.Fec_Fac" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Cliente *</label>
                        <InputSelect @bind-Value="Factura.Id_Cli_Per" @bind-Value:after="OnClienteChanged" class="form-control">
                            <option value="0">Seleccionar cliente...</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id_Cli">@c.NombreCompleto - @c.Num_Documento</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <!-- Sección 2: Detalles de Productos -->
            <div class="form-section">
                <h4 class="section-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16">
                        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    Detalles de la Factura
                </h4>
                
                <div class="table-responsive">
                    <table class="lineas-table">
                        <thead>
                            <tr>
                                <th style="width: 35%;">Producto</th>
                                <th style="width: 15%;">Cantidad</th>
                                <th style="width: 15%;">Precio Unit.</th>
                                <th style="width: 15%;">Descuento %</th>
                                <th style="width: 15%;">Total</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Factura.Detalles)
                            {
                                <tr>
                                    <td>
                                        <InputSelect @bind-Value="detalle.Id_Pro_Per" @bind-Value:after="() => OnProductoSeleccionado(detalle)" class="form-control">
                                            <option value="0">Seleccionar...</option>
                                            @foreach (var p in productos)
                                            {
                                                <option value="@p.Id_Pro">@p.Nom_Pro</option>
                                            }
                                        </InputSelect>
                                    </td>
                                    <td><InputNumber @bind-Value="detalle.Cantidad_Comprada" @bind-Value:after="CalcularTotales" class="form-control text-center" /></td>
                                    <td><InputNumber @bind-Value="detalle.Precio_Venta_Unit" @bind-Value:after="CalcularTotales" step="0.01" class="form-control text-end" /></td>
                                    <td><InputNumber @bind-Value="detalle.Porcentaje_Descuento" @bind-Value:after="CalcularTotales" step="0.01" class="form-control text-end" disabled="true" /></td>
                                    <td class="text-end fw-bold">@detalle.Precio_Venta_Total.ToString("C")</td>
                                    <td class="text-center">
                                        <button type="button" @onclick="() => Factura.Detalles.Remove(detalle)" class="btn-icon-danger" title="Eliminar línea">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a.5.5 0 0 1-0-1h3.5a.5.5 0 0 1 1 .5h4a.5.5 0 0 1 1-.5h3.5a.5.5 0 0 1 0 1h-.5zm-11-1a1 1 0 0 0-1 1v1h11V3a1 1 0 0 0-1-1H2.5zm3 4a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="add-line-container">
                    <button type="button" @onclick="AgregarDetalle" class="btn-add-line">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                        </svg>
                        Agregar Producto
                    </button>
                </div>
            </div>

            <!-- Sección 3: Pago y Totales -->
            <div class="form-grid-2 payment-totals-wrapper">
                <!-- Columna Izquierda: Datos de Pago -->
                <div class="form-section payment-section">
                    <h4 class="section-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-credit-card" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v1h14V4a1 1 0 0 0-1-1H2zm13 4H1v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V7z"/>
                            <path d="M2 10a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-1z"/>
                        </svg>
                        Datos de Pago
                    </h4>
                    
                    <div class="form-grid-2">
                         <div class="form-group">
                            <label>Establecimiento</label>
                            <InputSelect @bind-Value="Factura.Establecimiento_Fac" class="form-control">
                                <option value="@Establecimiento.Matriz">Matriz</option>
                                <option value="@Establecimiento.SucursalCentro">Sucursal Centro</option>
                                <option value="@Establecimiento.SucursalNorte">Sucursal Norte</option>
                                <option value="@Establecimiento.SucursalSur">Sucursal Sur</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>Punto de Venta</label>
                            <InputText @bind-Value="Factura.Punto_Venta" placeholder="Ej: PV-001" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label>Forma de Pago</label>
                            <InputSelect @bind-Value="Factura.Forma_Pago" class="form-control">
                                <option value="@FormaPago.Efectivo">Efectivo</option>
                                <option value="@FormaPago.Tarjeta">Tarjeta</option>
                            </InputSelect>
                        </div>
                        
                        <div class="form-group">
                            <label>Plazo (días)</label>
                            <InputNumber @bind-Value="Factura.Plazo_Pago_Dias" placeholder="0" class="form-control" />
                        </div>
                    </div>

                    @if (Factura.Forma_Pago == FormaPago.Tarjeta)
                    {
                        <div class="card-details-panel">
                            <div class="form-group full-width">
                                <label>Número de Tarjeta</label>
                                <InputText @bind-Value="Factura.NumeroTarjeta" placeholder="0000 0000 0000 0000" class="form-control" />
                            </div>
                            <div class="form-grid-2">
                                <div class="form-group">
                                    <label>Titular</label>
                                    <InputText @bind-Value="Factura.TitularTarjeta" placeholder="Nombre en tarjeta" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label>Vencimiento</label>
                                    <div class="d-flex gap-2">
                                        <InputText @bind-Value="Factura.FechaVencimiento" placeholder="MM/YY" class="form-control" />
                                        <InputText @bind-Value="Factura.CVV" placeholder="CVV" class="form-control" style="width: 80px;" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Columna Derecha: Totales -->
                <div class="form-section totals-section">
                    <h4 class="section-title">Resumen</h4>
                    <div class="totals-grid">
                        <div class="total-row">
                            <span class="label">Subtotal</span>
                            <span class="value">@Factura.Tot_Fac_Sin_IVA.ToString("C")</span>
                        </div>
                        <div class="total-row discount">
                            <span class="label">Descuento</span>
                            <span class="value">- @Factura.Tot_Descuento.ToString("C")</span>
                        </div>
                        <div class="total-row">
                            <span class="label">IVA (12%)</span>
                            <span class="value">@Factura.IVA_Fac.ToString("C")</span>
                        </div>
                        <div class="total-divider"></div>
                        <div class="total-row grand-total">
                            <span class="label">TOTAL</span>
                            <span class="value">@Factura.Tot_Fac_Con_IVA.ToString("C")</span>
                        </div>
                    </div>
                    
                    <div class="form-actions-vertical">
                        <button type="submit" class="action-btn primary-btn full-width">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                            </svg>
                            Guardar Factura
                        </button>
                        <button type="button" class="action-btn secondary full-width" @onclick="OnCancelar">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public FacturaModel Factura { get; set; } = new();
    [Parameter] public EventCallback OnGuardar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private List<Models.Cliente> clientes = new();
    private List<Models.Producto> productos = new();

    protected override async Task OnInitializedAsync()
    {
        clientes = await ClienteService.GetClientesAsync();
        productos = await ProductoService.GetProductosAsync();
    }

    private void AgregarDetalle()
    {
        Factura.Detalles.Add(new DetalleFactura());
    }

    private void OnClienteChanged()
    {
        var clienteSeleccionado = clientes.FirstOrDefault(c => c.Id_Cli == Factura.Id_Cli_Per);
        if (clienteSeleccionado != null)
        {
            Factura.ClienteNombre = clienteSeleccionado.NombreCompleto;
        }
    }

    private async Task OnProductoSeleccionado(DetalleFactura detalle)
    {
        var prod = productos.FirstOrDefault(p => p.Id_Pro == detalle.Id_Pro_Per);
        if (prod != null)
        {
            detalle.Precio_Venta_Unit = prod.Precio_Venta;
            var desc = await DescuentoService.GetDescuentoActivoAsync(prod.Id_Pro);
            detalle.Porcentaje_Descuento = desc?.Porcentaje ?? 0;
            await CalcularTotales();
        }
    }

    private async Task CalcularTotales()
    {
        // Calculate subtotal without discounts
        var subtotalSinDescuento = Factura.Detalles.Sum(d => d.Cantidad_Comprada * d.Precio_Venta_Unit);
        // Calculate total discounts
        decimal totalDescuentos = 0m;
        foreach (var detalle in Factura.Detalles)
        {
            var prod = productos.FirstOrDefault(p => p.Id_Pro == detalle.Id_Pro_Per);
            if (prod != null)
            {
                var desc = await DescuentoService.GetDescuentoActivoAsync(prod.Id_Pro);
                var perc = desc?.Porcentaje ?? 0;
                detalle.Porcentaje_Descuento = perc;
                totalDescuentos += (detalle.Cantidad_Comprada * detalle.Precio_Venta_Unit) * (perc / 100m);
            }
        }
        Factura.Tot_Descuento = totalDescuentos;
        Factura.Tot_Fac_Sin_IVA = subtotalSinDescuento - totalDescuentos;
        Factura.IVA_Fac = Factura.Tot_Fac_Sin_IVA * 0.12m;
        Factura.Tot_Fac_Con_IVA = Factura.Tot_Fac_Sin_IVA + Factura.IVA_Fac;
        await OnGuardar.InvokeAsync();
    }
}