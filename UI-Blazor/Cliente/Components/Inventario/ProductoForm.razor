@using Application.DTOs.Producto

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IImagenService ImagenService

<div class="producto-form-container">
    <form class="producto-form" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
        <h3 class="form-section-title">Detalle del producto / servicio</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                ⚠️ @errorMessage
            </div>
        }

        <!-- Características Generales -->
        <div class="form-section-box">
            <h4 class="section-subtitle">Información del ProductoDto</h4>
            
            <div class="form-grid">
                <div class="form-column-left">
                    <!-- Área para imagen/logo del producto -->
                    <div class="product-image-container">
                        <label for="productImageInput" class="product-image-placeholder">
                            @if (!string.IsNullOrEmpty(Model.Imagen))
                            {
                                <img src="@Model.Imagen" alt="Imagen" class="product-image-preview" />
                                <button type="button" class="btn-remove-image" @onclick="RemoveImage" @onclick:preventDefault @onclick:stopPropagation="true" title="Eliminar imagen">×</button>
                            }
                            else
                            {
                                <div class="image-icon">📦</div>
                                <p>Haz clic para subir imagen</p>
                            }
                        </label>
                        <InputFile id="productImageInput" OnChange="HandleImageUpload" accept="image/*" style="display:none" />
                    </div>
                </div>
                
                <div class="form-column-right">
                    <div class="form-row-inline">
                        <div class="form-group">
                            <label>Tipo de ProductoDto *</label>
                            <input type="text" 
                                   class="form-control" 
                                   @bind="Model.Tip_Pro" 
                                   placeholder="Ej: Alimenticio, Bebida, Limpieza..."
                                   required />
                        </div>
                    </div>

                    <div class="form-row-inline">
                        <div class="form-group">
                            <label>Nombre del ProductoDto *</label>
                            <input type="text" 
                                   class="form-control wide-input" 
                                   @bind="Model.Nom_Pro" 
                                   placeholder="Ej: Coca Cola 750ml"
                                   required />
                        </div>
                    </div>

                    <div class="form-row-inline">
                        <div class="form-group">
                            <label>Marca *</label>
                            <input type="text" 
                                   class="form-control" 
                                   @bind="Model.Marca" 
                                   placeholder="Ej: Coca Cola Company"
                                   required />
                        </div>
                    </div>

                    <div class="form-row-inline">
                        <div class="form-group">
                            <label>Precio de Venta (PVP) *</label>
                            <input type="number" 
                                   class="form-control" 
                                   @bind="Model.Precio_Venta" 
                                   placeholder="0.00"
                                   step="0.01"
                                   min="0"
                                   required />
                            <small class="form-hint">Precio al público actual</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de LoteDtos y Precios -->
        <div class="form-section-box lote-section">
            <h4 class="section-subtitle">
                📦 Información de LoteDto Inicial
                <span class="info-badge">Tabla separada: lotes</span>
            </h4>
            
            <div class="form-grid-2col">
                <div class="form-group">
                    <label>Fecha de Entrada</label>
                    <input type="date" 
                           class="form-control" 
                           @bind="Model.Fec_Ent" />
                    <small class="form-hint">Fecha de recepción del lote</small>
                </div>

                <div class="form-group">
                    <label>Fecha de Expiración</label>
                    <input type="date" 
                           class="form-control" 
                           @bind="Model.Fec_Exp" />
                    <small class="form-hint">Fecha de vencimiento del producto</small>
                </div>

                <div class="form-group">
                    <label>Cantidad Recibida</label>
                    <input type="number" 
                           class="form-control" 
                           @bind="Model.Cantidad_Recibida" 
                           placeholder="Ej: 100"
                           min="1" />
                    <small class="form-hint">Unidades recibidas en el lote</small>
                </div>

                <div class="form-group">
                    <label>Cantidad Disponible</label>
                    <input type="number" 
                           class="form-control" 
                           @bind="Model.Cantidad_Disponible" 
                           placeholder="Ej: 100"
                           min="0" />
                    <small class="form-hint">Unidades actualmente disponibles</small>
                </div>

                <div class="form-group">
                    <label>Costo Unitario (USD)</label>
                    <input type="number" 
                           class="form-control" 
                           @bind="Model.Precio_Unitario" 
                           placeholder="0.00"
                           step="0.01"
                           min="0" />
                    <small class="form-hint">Costo de adquisición por unidad</small>
                </div>
            </div>

            <div class="lote-info-display">
                <div class="calculated-info">
                    <span class="info-label">Costo Total del LoteDto:</span>
                    <span class="info-value">
                        $@((Model.Cantidad_Recibida.GetValueOrDefault() * Model.Precio_Unitario.GetValueOrDefault()).ToString("N2"))
                    </span>
                </div>
            </div>
        </div>

        <!-- Botones de acción -->
        <div class="form-actions">
            <button type="submit" class="btn btn-guardar">Guardar ProductoDto</button>
            <button type="button" class="btn btn-cancelar" @onclick="() => OnCancelar.InvokeAsync()">Cancelar</button>
        </div>
    </form>
</div>



@code {
    [Parameter]
    public ProductoDto Model { get; set; } = new();

    [Parameter]
    public EventCallback OnGuardar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    // Removed [Inject] attribute here since we are using @inject directive at the top
    // private IImagenService? ImagenService { get; set; }

    private string? previousImageUrl;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        // Guardar la URL de imagen anterior para poder eliminarla si se cambia
        previousImageUrl = Model.Imagen;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;

        // Validar que los campos requeridos estén completos
        if (string.IsNullOrWhiteSpace(Model.Tip_Pro) ||
            string.IsNullOrWhiteSpace(Model.Nom_Pro) ||
            string.IsNullOrWhiteSpace(Model.Marca))
        {
            return;
        }

        // Validación de Precios: PVP no puede ser menor al Costo Unitario
        // Solo validamos si ambos tienen valor (el costo es opcional en el modelo, pero si se ingresa, se valida)
        if (Model.Precio_Unitario.HasValue && Model.Precio_Venta < Model.Precio_Unitario.Value)
        {
            errorMessage = $"El Precio de Venta (${Model.Precio_Venta:N2}) no puede ser menor al Costo Unitario (${Model.Precio_Unitario:N2})";
            return;
        }

        // Si se ingresó cantidad recibida pero no disponible, asumir que es igual
        if (Model.Cantidad_Recibida.HasValue && !Model.Cantidad_Disponible.HasValue)
        {
            Model.Cantidad_Disponible = Model.Cantidad_Recibida;
        }

        await OnGuardar.InvokeAsync();
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && ImagenService != null)
        {
            // Limitar tamaño a 5MB
            var maxSize = 5 * 1024 * 1024;
            if (file.Size > maxSize)
            {
                Console.WriteLine("El archivo es demasiado grande (máximo 5MB)");
                return;
            }

            try
            {
                // Subir la imagen al servidor
                using var stream = file.OpenReadStream(maxSize);
                var imageUrl = await ImagenService.UploadImageAsync(stream, file.Name);

                if (!string.IsNullOrEmpty(imageUrl))
                {
                    // Si había una imagen anterior y es diferente, eliminarla
                    if (!string.IsNullOrEmpty(previousImageUrl) && 
                        previousImageUrl != imageUrl &&
                        !previousImageUrl.StartsWith("data:"))
                    {
                        await ImagenService.DeleteImageAsync(previousImageUrl);
                    }

                    // Actualizar la URL de la imagen
                    Model.Imagen = imageUrl;
                    previousImageUrl = imageUrl;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al subir imagen: {ex.Message}");
            }
        }
    }

    private async Task RemoveImage()
    {
        if (!string.IsNullOrEmpty(Model.Imagen) && ImagenService != null)
        {
            // Solo eliminar si no es una imagen Base64
            if (!Model.Imagen.StartsWith("data:"))
            {
                await ImagenService.DeleteImageAsync(Model.Imagen);
            }
            Model.Imagen = null;
            previousImageUrl = null;
        }
    }
}