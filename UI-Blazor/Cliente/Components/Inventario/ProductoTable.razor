@using Application.DTOs.Producto

<div class="productos-table-container">
    @if (ToolBarContent != null)
    {
        <div class="table-toolbar">
            @ToolBarContent
        </div>
    }
    <table class="productos-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Nombre</th>
                <th class="col-type">Tipo</th>
                <th class="col-brand">Marca</th>
                <th class="col-price">Precio Venta</th>
                <th class="col-date">Fecha Entrada</th>
                <th class="col-stock">Stock (Rec/Disp)</th>
                <th class="col-actions">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Productos != null && Productos.Any())
            {
                @foreach (var producto in Productos)
                {
                    <tr>
                        <td class="text-center">@producto.Id_Pro</td>
                        <td>
                            <div class="fw-bold">@producto.Nom_Pro</div>
                        </td>
                        <td>
                            <span class="badge @(producto.Tip_Pro == "Bien" ? "bg-success" : "bg-info")">
                                @producto.Tip_Pro
                            </span>
                        </td>
                        <td>@producto.Marca</td>
                        <td>@producto.Precio_Venta.ToString("C")</td>
                        <td class="text-center">
                            @if (producto.Lotes != null && producto.Lotes.Any())
                            {
                                @producto.Lotes.First().Fec_Ent.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (producto.Lotes != null && producto.Lotes.Any())
                            {
                                var totalRecibido = producto.Lotes.Sum(l => l.Cantidad_Recibida);
                                var totalDisponible = producto.Lotes.Sum(l => l.Cantidad_Disponible);
                                <span>@totalRecibido / <strong>@totalDisponible</strong></span>
                            }
                            else
                            {
                                <span class="text-muted">0 / 0</span>
                            }
                        </td>
                        <td class="text-center actions-col">
                            <div class="d-flex justify-content-center gap-2">
                                <button class="action-btn-icon view" @onclick="() => OnView.InvokeAsync(producto.Id_Pro)" title="Ver Detalles">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/>
                                    </svg>
                                </button>
                                <button class="action-btn-icon edit" @onclick="() => OnEdit.InvokeAsync(producto.Id_Pro)" title="Editar">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                    </svg>
                                </button>
                                <button class="action-btn-icon add-batch" @onclick="() => OnAddBatch.InvokeAsync(producto.Id_Pro)" title="Agregar Lote">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                        <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                                    </svg>
                                </button>
                                <button class="action-btn-icon delete" @onclick="() => OnDelete.InvokeAsync(producto.Id_Pro)" title="Eliminar">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-5">
                       <div class="empty-state">
                            <span class="text-muted">No se encontraron productos</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination Bottom (Inside Container) -->
    @if (TotalPages > 1)
    {
        <div class="pagination-container bottom-pagination">
            <button class="pagination-btn prev-next" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
            </button>
            
            <div class="page-numbers">
                    @foreach (var p in GetPageNumbers())
                {
                    @if (p == -1)
                    {
                        <span class="pagination-ellipsis">...</span>
                    }
                    else
                    {
                        <button class="pagination-btn number @(p == CurrentPage ? "active" : "")" 
                                @onclick="() => ChangePage(p)">
                            @p
                        </button>
                    }
                }
            </div>

            <button class="pagination-btn prev-next" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
                </svg>
            </button>
        </div> 
    }
</div>

@code {
    [Parameter]
    public List<ProductoDto> Productos { get; set; } = new();

    [Parameter] public RenderFragment? ToolBarContent { get; set; }

    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnView { get; set; }

    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    [Parameter]
    public EventCallback<int> OnAddBatch { get; set; }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var gap = 2;

        if (TotalPages <= 7)
        {
            for (int i = 1; i <= TotalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (CurrentPage > gap + 2) pages.Add(-1);

            var start = Math.Max(2, CurrentPage - gap);
            var end = Math.Min(TotalPages - 1, CurrentPage + gap);

            for (int i = start; i <= end; i++) pages.Add(i);

            if (CurrentPage < TotalPages - (gap + 1)) pages.Add(-1);
            pages.Add(TotalPages);
        }
        return pages;
    }
}
